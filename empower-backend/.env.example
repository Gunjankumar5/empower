# EMPOWER SAFE Backend Configuration
# Copy this file to .env and fill in your values

# MongoDB (Docker: leave as-is for default credentials, or override)
MONGO_USER=admin
MONGO_PASSWORD=password

# JWT Authentication (REQUIRED - change for production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Twilio SMS Gateway (OPTIONAL - SOS works without this, but won't send SMS)
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Firebase Cloud Messaging (OPTIONAL - push notifications will be skipped if not configured)
FIREBASE_SERVICE_ACCOUNT=/path/to/firebase-service-account.json

# Server Port (usually 5000)
PORT=5000
